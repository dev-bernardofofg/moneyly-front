{
  "name": "moneyly-front",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "pnpm lint && pnpm type-check",
    "ci:install": "pnpm install --frozen-lockfile",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.js",
    "generate-notification-icons": "node scripts/generate-notification-icons.js",
    "generate-hooks": "kubb --config kubb.config.ts && orval --config orval.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-input/number-format": "^2.0.3",
    "@react-oauth/google": "^0.13.5",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.19.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-number-format": "^5.4.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.21"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@kubb/cli": "^4.39.3",
    "@kubb/core": "^4.39.3",
    "@kubb/plugin-oas": "^4.39.3",
    "@kubb/plugin-ts": "^4.39.3",
    "@kubb/plugin-zod": "^4.39.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "orval": "^8.44.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
