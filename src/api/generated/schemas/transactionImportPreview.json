{
  "type": "object",
  "properties": {
    "accountKey": { "type": "string" },
    "bill": {
      "type": "object",
      "nullable": true,
      "properties": {
        "dueDate": { "type": "string", "example": "2026-05-17T00:00:00.000Z" },
        "total": { "type": "number", "nullable": true }
      },
      "required": ["dueDate", "total"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "externalId": { "type": "string" },
          "type": { "type": "string", "enum": ["income", "expense"] },
          "amount": { "type": "number" },
          "date": { "type": "string", "example": "2026-05-17T00:00:00.000Z" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["new", "imported", "possible_duplicate", "bill_payment", "transfer"]
          },
          "duplicateOf": { "type": "string", "nullable": true, "format": "uuid" },
          "transferOf": {
            "type": "object",
            "nullable": true,
            "properties": {
              "transactionId": { "type": "string", "format": "uuid" },
              "accountId": { "type": "string", "format": "uuid" }
            },
            "required": ["transactionId", "accountId"]
          },
          "suggestedCategoryId": { "type": "string", "nullable": true, "format": "uuid" },
          "suggestionSource": { "type": "string", "enum": ["history", "rule", "fallback"] }
        },
        "required": [
          "externalId",
          "type",
          "amount",
          "date",
          "title",
          "status",
          "duplicateOf",
          "transferOf",
          "suggestedCategoryId",
          "suggestionSource"
        ]
      }
    }
  },
  "required": ["accountKey", "bill", "items"],
  "x-readme-ref-name": "TransactionImportPreview"
}
